{
  "name": "site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.15.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format:check": "prettier --check 'src/**/*.{astro,ts,css}' 'tests/**/*.ts' '*.json' '*.mjs' 'pnpm-workspace.yaml' '*.md'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write 'src/**/*.{astro,ts,css}' 'tests/**/*.ts' '*.json' '*.mjs' 'pnpm-workspace.yaml' '*.md'"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "astro": "7.3.1",
    "@astrojs/sitemap": "3.7.4",
    "fuse.js": "7.5.0",
    "lucide": "1.47.0",
    "mdast-util-to-string": "4.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/mdast": "4.0.4",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
